rules_version = '2';
// ==========================================================================
// PROJECT: CBT KELAS VII (cbt-6a20d), KELAS VIII (cbt-viii), KELAS IX (cbt-ix)
// Salin isi berkas ini ke Firestore > Rules di TIGA project tersebut.
// Koleksi: tokens, hasil, sesi, pengaturan, akunGuru
// Siswa tidak login (anonim): hanya boleh membaca satu token, menulis
// sesinya sendiri, dan mengirim hasilnya sendiri.
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== GANTI dengan email admin Anda (sama di kelima project) =====
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["GANTI_DENGAN_EMAIL_ADMIN@contoh.com"];
    }
    // Guru sah = emailnya terdaftar di koleksi akunGuru project ini
    // (didaftarkan admin saat menekan Aktifkan di halaman Akun Guru).
    function isGuru() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/akunGuru/$(request.auth.token.email));
    }
    function isStaff() { return isAdmin() || isGuru(); }

    // Daftar email guru: hanya admin yang menulis; guru hanya membaca miliknya.
    match /akunGuru/{email} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Token ujian. Siswa membaca SATU token (get) untuk masuk; daftar token
    // (list) hanya untuk admin/guru. Hanya admin yang membuat/ubah/hapus.
    match /tokens/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Hasil ujian. ID dokumen = token_nis.
    // Siswa boleh membuat hasil sekali dan mengirim ulang (idempoten);
    // nilai dan jawaban yang sudah tersimpan tidak bisa diubah siswa.
    match /hasil/{id} {
      allow get: if true;                 // cek "sudah mengerjakan"
      allow list: if isStaff();
      allow create: if hasilValid(id);
      allow update: if hasilValid(id)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["waktu", "mulai", "durasi", "pelanggaran"]);
      allow delete: if isAdmin();
    }

    function hasilValid(id) {
      let d = request.resource.data;
      return d.token is string && d.nis is string
        && id == d.token + "_" + d.nis
        && d.tingkat in ["VII", "VIII", "IX"]
        && d.keys().size() <= 40
        && (d.nilai == null || (d.nilai is number && d.nilai >= 0 && d.nilai <= 100))
        && (d.benar == null || (d.benar is number && d.benar >= 0))
        && (d.salah == null || (d.salah is number && d.salah >= 0))
        && d.waktu == request.time;
    }

    // Sesi ujian berjalan (untuk monitoring). ID dokumen = token_nis.
    match /sesi/{id} {
      allow read: if isStaff();
      allow create: if sesiBaru(id);
      allow update: if sesiLama();
      allow delete: if isAdmin();
    }

    function sesiBaru(id) {
      let d = request.resource.data;
      return d.token is string && d.nis is string
        && id == d.token + "_" + d.nis
        && d.keys().size() <= 40;
    }
    // Identitas sesi tidak boleh diganti siswa.
    function sesiLama() {
      let d = request.resource.data;
      return d.token == resource.data.token
        && d.nis == resource.data.nis
        && d.keys().size() <= 40;
    }

    // Pengaturan (jumlah siswa untuk dasbor).
    match /pengaturan/{doc} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Selain di atas: ditolak.
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
