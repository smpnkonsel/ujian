rules_version = '2';
// ==========================================================================
// PROJECT: DATA SISWA DAN GURU (dat-guru-siswa)
// Koleksi: siswa, guru, kelas, Daftar, akunGuru
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== GANTI dengan email admin Anda (sama di kelima project) =====
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["admin@smpn20.id"];
    }
    // Guru sah = emailnya terdaftar di koleksi akunGuru project ini.
    function isGuru() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/akunGuru/$(request.auth.token.email));
    }
    function isStaff() { return isAdmin() || isGuru(); }

    // Daftar email guru: hanya admin yang menulis; guru hanya membaca miliknya.
    match /akunGuru/{email} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Siswa: halaman ujian mencari siswa berdasarkan NIS (satu dokumen).
    // Daftar lengkap siswa hanya untuk admin/guru.
    match /siswa/{nis} {
      allow get: if true;
      allow list: if isStaff() || request.query.limit <= 1;
      allow write: if isAdmin();
    }

    // Guru: berisi email dan sandi awal akun, jadi sangat dibatasi.
    // Admin membaca semua; guru hanya dokumennya sendiri (dicari lewat
    // akunEmail saat login).
    match /guru/{id} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.akunEmail != null
            && resource.data.akunEmail == request.auth.token.email);
      allow write: if isAdmin();
    }

    // Koleksi kelas (wali kelas, tahun ajaran).
    match /kelas/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Daftar/mapel: dibaca staf (admin & guru), ditulis admin.
    match /Daftar/{dok} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
