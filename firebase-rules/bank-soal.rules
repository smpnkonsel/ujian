rules_version = '2';
// ==========================================================================
// PROJECT: BANK SOAL DAN JADWAL (bank-soal-edaf4)
// Koleksi: paket, jadwal, akunGuru, pengaturan
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== GANTI dengan email admin Anda (sama di kelima project) =====
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["admin@smpn20.id"];
    }
    // Guru sah = emailnya terdaftar di koleksi akunGuru project ini
    // (didaftarkan admin saat menekan Aktifkan di halaman Akun Guru).
    function isGuru() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/akunGuru/$(request.auth.token.email));
    }
    function isStaff() { return isAdmin() || isGuru(); }

    // Daftar email guru: hanya admin yang menulis; guru hanya membaca miliknya.
    match /akunGuru/{email} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Jadwal: halaman ujian siswa mencari jadwal berdasarkan tingkat.
    match /jadwal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Paket soal: siswa membaca satu paket (get) saat ujian dimulai;
    // daftar paket hanya untuk admin/guru.
    // Guru hanya boleh membuat paket atas namanya sendiri dan
    // mengubah/menghapus paket miliknya. Paket lama tanpa guruEmail
    // hanya bisa diubah/dihapus admin.
    match /paket/{id} {
      allow get: if true;
      allow list: if isStaff();

      allow create: if isAdmin()
        || (isGuru()
            && request.resource.data.guruEmail == request.auth.token.email);

      allow update: if isAdmin()
        || (isGuru()
            && resource.data.guruEmail == request.auth.token.email
            && request.resource.data.guruEmail == resource.data.guruEmail);

      allow delete: if isAdmin()
        || (isGuru()
            && resource.data.guruEmail == request.auth.token.email);
    }

    // Pengaturan: dibaca semua; ditulis oleh pengguna yang login.
    match /pengaturan/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}